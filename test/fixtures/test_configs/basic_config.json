{
  "version": "1.0",
  "machine": "test-machine",
  "git": {
    "repo_path": "/app/test-data/dotfiles-test",
    "remote_url": "",
    "branch": "main",
    "auth_type": "none"
  },
  "sync": {
    "auto_sync_enabled": true,
    "debounce_seconds": 1,
    "auto_commit": true,
    "auto_push": true,
    "auto_pull": false,
    "backoff": {
      "enabled": true,
      "max_delay_seconds": 10,
      "multiplier": 2,
      "churn_threshold": 5,
      "churn_window_seconds": 30,
      "decay_reset_seconds": 60,
      "manual_sync_timeout_seconds": 120
    }
  },
  "notifications": {
    "enabled": false,
    "show_success": false,
    "show_pulls": false,
    "play_sound_on_conflict": false
  },
  "conflict_resolution": {
    "strategy": "stash",
    "backup_dir": "/app/test-data/dotfiles-test/.backup",
    "auto_resolve": false
  },
  "ui": {
    "theme": "default",
    "show_progress": true,
    "compact_mode": false
  },
  "advanced": {
    "log_level": "debug",
    "max_log_size_mb": 10,
    "keep_backups_days": 7,
    "enable_metrics": false,
    "performance_mode": false
  },
  "mappings": {
    "/app/test-data/source_dotfiles/.bashrc": "/app/test-data/dotfiles-test/.bashrc",
    "/app/test-data/source_dotfiles/.vimrc": "/app/test-data/dotfiles-test/.vimrc",
    "/app/test-data/source_dotfiles/.gitconfig": "/app/test-data/dotfiles-test/.gitconfig"
  }
}