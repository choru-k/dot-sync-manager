{
  "machine": {
    "name": "test-machine",
    "description": "E2E Test Machine"
  },
  "git": {
    "repo_path": "/app/test-data/dotfiles-test",
    "remote_url": "",
    "auth_type": "none",
    "ssh_key_path": "",
    "known_hosts_path": "",
    "branch": "main"
  },
  "sync": {
    "auto_sync_enabled": true,
    "debounce_seconds": 1,
    "conflict_resolution": {
      "strategy": "stash",
      "backup_dir": "/app/test-data/dotfiles-test/.backup"
    },
    "max_retries": 3
  },
  "notifications": {
    "enabled": false,
    "webhook_url": "",
    "email_enabled": false
  },
  "mappings": {
    "/app/test-data/source_dotfiles/.bashrc": "/app/test-data/dotfiles-test/.bashrc",
    "/app/test-data/source_dotfiles/.vimrc": "/app/test-data/dotfiles-test/.vimrc",
    "/app/test-data/source_dotfiles/.gitconfig": "/app/test-data/dotfiles-test/.gitconfig"
  },
  "ignore_patterns": [
    "*.tmp",
    "*.log",
    ".DS_Store",
    "node_modules/",
    ".cache/"
  ],
  "backoff": {
    "enabled": true,
    "initial_delay": 1,
    "max_delay": 10,
    "multiplier": 2,
    "jitter": 0.1
  }
}