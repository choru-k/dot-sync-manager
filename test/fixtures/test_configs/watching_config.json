{
  "machine": {
    "name": "test-machine-watching",
    "description": "E2E Test Machine for File Watching"
  },
  "git": {
    "repo_path": "/app/test-data/dotfiles-test-watch",
    "remote_url": "",
    "auth_type": "none",
    "ssh_key_path": "",
    "known_hosts_path": "",
    "branch": "main"
  },
  "sync": {
    "auto_sync_enabled": true,
    "debounce_seconds": 1,
    "conflict_resolution": {
      "strategy": "stash",
      "backup_dir": "/app/test-data/dotfiles-test-watch/.backup"
    },
    "max_retries": 3
  },
  "notifications": {
    "enabled": false,
    "webhook_url": "",
    "email_enabled": false
  },
  "mappings": {
    "/app/test-data/source_dotfiles/.watchtest": "/app/test-data/dotfiles-test-watch/.watchtest",
    "/app/test-data/source_dotfiles/.multitest1": "/app/test-data/dotfiles-test-watch/.multitest1",
    "/app/test-data/source_dotfiles/.multitest2": "/app/test-data/dotfiles-test-watch/.multitest2",
    "/app/test-data/source_dotfiles/.multitest3": "/app/test-data/dotfiles-test-watch/.multitest3",
    "/app/test-data/source_dotfiles/.debouncetest": "/app/test-data/dotfiles-test-watch/.debouncetest"
  },
  "ignore_patterns": [
    "*.tmp",
    "*.log",
    ".DS_Store",
    "node_modules/",
    ".cache/"
  ],
  "backoff": {
    "enabled": true,
    "initial_delay": 1,
    "max_delay": 10,
    "multiplier": 2,
    "jitter": 0.1
  }
}