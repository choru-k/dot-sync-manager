[user]
    name = Test User
    email = test@example.com
[core]
    editor = nano
    autocrlf = input
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
[pull]
    rebase = false
[push]
    default = simple
[init]
    defaultBranch = main
[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    unstage = reset HEAD --
    last = log -1 HEAD
    visual = !gitk
[merge]
    tool = vimdiff
[diff]
    tool = vimdiff
